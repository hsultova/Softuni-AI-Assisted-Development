@model TodoApp.Models.Todo

@{
    ViewData["Title"] = "Create Todo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Create New Todo</h1>
            <hr />
            <form asp-action="Create" method="post" class="ajax-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter todo title" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter description (optional)"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>

                               <div class="mb-3">
                                   <label asp-for="Priority" class="form-label"></label>
                                   <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TodoApp.Models.Priority>()" class="form-select"></select>
                                   <span asp-validation-for="Priority" class="text-danger"></span>
                               </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ProjectId" class="form-label">Project</label>
                    @Html.DropDownListFor(model => model.ProjectId, (SelectList)ViewBag.Projects, "No project", new { @class = "form-select" })
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
