@model IEnumerable<TodoApp.Models.Todo>

@{
    ViewData["Title"] = "My Todos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Todos</h1>
        <a asp-action="Create" class="btn btn-primary">Add New Todo</a>
    </div>

    <form id="anti-forgery-form">@Html.AntiForgeryToken()</form>

    <div class="row mb-4 align-items-end">
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="projectId" class="visually-hidden">Project</label>
                    @Html.DropDownList("projectId", (SelectList)ViewData["Projects"], "All Projects", new { @class = "form-select", @id = "projectId" })
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Show All</a>
                </div>
            </form>
        </div>
        <div class="col-md-auto">
            <a asp-controller="Projects" asp-action="Index" class="btn btn-primary">Manage Projects</a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div id="todos-list" class="row">
            @foreach (var todo in Model)
            {
                   <div class="col-md-6 mb-3">
                       <div id="todo-card-@todo.Id" class="card @(todo.IsDone ? "border-success" : "") todo-card-@todo.Priority.ToString().ToLower()" data-isdone="@(todo.IsDone.ToString().ToLower())" data-priority="@((int)todo.Priority)">
                        <div class="card-body">
                            <h5 id="todo-title-@todo.Id" class="card-title @(todo.IsDone ? "text-muted text-decoration-line-through" : "")">
                                @todo.Title
                            </h5>
                            @if (!string.IsNullOrEmpty(todo.Description))
                            {
                                <p class="card-text text-muted">@todo.Description</p>
                            }
                            <div class="small text-secondary mb-3">
                                <div>Created: @todo.CreatedAt.ToString("MMM dd, yyyy")</div>
                                @if (todo.DueDate.HasValue)
                                {
                                    <div>Due: @todo.DueDate.Value.ToString("MMM dd, yyyy")</div>
                                }
                                @if (todo.Project != null)
                                {
                                    <div>Project: <span class="badge bg-info text-dark">@todo.Project.Name</span></div>
                                }
                                <div>Status: <span id="todo-status-@todo.Id" class="badge @(todo.IsDone ? "bg-success" : "bg-warning")">
                                    @(todo.IsDone ? "Completed" : "Pending")
                                   </span></div>
                                   <div>Priority: <span id="todo-priority-@todo.Id" class="badge @(todo.Priority == TodoApp.Models.Priority.High ? "bg-danger" : todo.Priority == TodoApp.Models.Priority.Medium ? "bg-warning" : "bg-secondary")">
                                       @todo.Priority
                                   </span></div>
                            </div>
                            <div class="btn-group" role="group">
                                <form asp-action="ToggleComplete" method="post" class="d-inline toggle-complete-form" data-id="@todo.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@todo.Id" />
                                    <button type="submit" class="btn btn-sm @(todo.IsDone ? "btn-outline-secondary" : "btn-outline-success")" aria-label="@(todo.IsDone ? "Undo" : "Mark Completed")" title="@(todo.IsDone ? "Undo" : "Mark Completed")">
                                        @if (todo.IsDone)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16" aria-hidden="true">
                                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                                <path d="M8 1v4l3-2-3-2z"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg" viewBox="0 0 16 16" aria-hidden="true">
                                                <path d="M13.485 1.929a.75.75 0 0 1 1.06 1.06L6.53 10.006a.75.75 0 0 1-1.06 0L1.455 6.0a.75.75 0 1 1 1.06-1.06L6 8.425l7.485-6.496z"/>
                                            </svg>
                                        }
                                    </button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@todo.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <button type="button" data-id="@todo.Id" class="btn btn-sm btn-outline-danger btn-delete-ajax">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div id="empty-message" class="alert alert-info" role="alert">
            <p>No todos yet. <a asp-action="Create">Create your first todo!</a></p>
        </div>
    }
</div>
