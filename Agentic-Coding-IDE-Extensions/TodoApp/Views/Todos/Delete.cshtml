@model TodoApp.Models.Todo

@{
    ViewData["Title"] = "Delete Todo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-danger">Delete Todo</h3>
            <hr />
            <div class="alert alert-warning">
                <strong>Are you sure you want to delete this todo?</strong>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="card-text">@Model.Description</p>
                    }
                    <div class="small text-secondary">
                        <div>Created: @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                        @if (Model.DueDate.HasValue)
                        {
                            <div>Due: @Model.DueDate.Value.ToString("MMM dd, yyyy")</div>
                        }
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
